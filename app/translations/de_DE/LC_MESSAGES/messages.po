#: app/web/templates/index.html:8 app/web/templates/security/email/_base.html:43
#: app/web/templates/security/email/_footer.txt:3
msgid "Good things deserve a second life."
msgstr "Gute Dinge verdienen ein zweites Leben."

#: app/web/templates/index.html:9
msgid ""
"A place for the things you care about. Bring a little order to fixing them, one repair at a "
"time."
msgstr ""
"Ein Ort für die Dinge, die dir wichtig sind. Bring Ordnung ins Reparieren – eine Reparatur "
"nach der anderen."

#: app/web/templates/index.html:10 app/web/templates/security/login_user.html:11
#: app/web/templates/security/register_user.html:5
msgid "Create an account"
msgstr "Konto erstellen"

#: app/web/templates/index.html:11
msgid "Already part of the workshop?"
msgstr "Schon Teil der Werkstatt?"

#: app/web/templates/index.html:13
msgid "Welcome to your workshop."
msgstr "Willkommen in deiner Werkstatt."

#: app/web/templates/index.html:14
#, python-format
msgid "You are logged in as %(username)s."
msgstr "Du bist als %(username)s angemeldet."

#: app/web/templates/index.html:16
msgid "Your account is ready. A new chapter for your things starts here."
msgstr "Dein Konto ist bereit. Hier beginnt ein neues Kapitel für deine Dinge."

#: app/web/templates/index.html:20
msgid "THE REPAIR MINDSET"
msgstr "REPARIEREN STATT ERSETZEN"

#: app/web/templates/index.html:20
msgid "FIG. 01"
msgstr "ABB. 01"

#: app/web/templates/index.html:22
msgid "Worth keeping."
msgstr "Wertvoll genug zum Behalten."

#: app/web/templates/index.html:22
msgid "Worth fixing."
msgstr "Wertvoll genug zum Reparieren."

#: app/web/templates/index.html:22
msgid "REPAIR"
msgstr "REPARIEREN"

#: app/web/templates/index.html:22
msgid "REPEAT"
msgstr "NOCHMAL"

#: app/web/templates/index.html:26
msgid "A LITTLE STRUCTURE. A LOT MORE POSSIBILITY."
msgstr "ETWAS MEHR STRUKTUR. VIEL MEHR MÖGLICHKEITEN."

#: app/web/templates/index.html:26
msgid "Manage your personal repairs."
msgstr "Verwalte deine privaten Reparaturen."

#: app/web/templates/index.html:26
msgid "COMING NEXT"
msgstr "DEMNÄCHST"

#: app/web/templates/index.html:27
msgid "Device management is ready. Repair tracking and costs are coming next."
msgstr "Die Geräteverwaltung ist bereit. Reparaturverlauf und Kosten folgen als Nächstes."

#: app/web/templates/index.html:29
msgid "Know your devices"
msgstr "Kenne deine Geräte"

#: app/web/templates/index.html:29
msgid "A home for the details that matter, from the model to its repair history."
msgstr "Alle wichtigen Details an einem Ort – vom Modell bis zur Reparaturhistorie."

#: app/web/templates/index.html:30
msgid "Follow the repair"
msgstr "Behalte die Reparatur im Blick"

#: app/web/templates/index.html:30
msgid "Keep the problem, the next steps and your progress together."
msgstr "Halte das Problem, die nächsten Schritte und deinen Fortschritt zusammen fest."

#: app/web/templates/index.html:31
msgid "See the full picture"
msgstr "Behalte den Überblick"

#: app/web/templates/index.html:31
msgid "Bring parts, time and costs into one clear view."
msgstr "Ersatzteile, Zeit und Kosten übersichtlich zusammengefasst."

#: app/web/templates/devices/detail.html:2
msgid "Device details"
msgstr "Gerätedetails"

#: app/web/templates/devices/detail.html:6
msgid "WORTH KEEPING"
msgstr "WERTVOLL GENUG ZUM BEHALTEN"

#: app/web/templates/devices/detail.html:9 app/web/templates/devices/form.html:2
#: app/web/templates/devices/form.html:7 app/web/templates/devices/index.html:4
#: app/web/templates/devices/index.html:12
msgid "Edit device"
msgstr "Gerät bearbeiten"

#: app/web/templates/devices/form.html:2 app/web/templates/devices/form.html:7
#: app/web/templates/devices/index.html:5
msgid "Add device"
msgstr "Gerät hinzufügen"

#: app/web/templates/devices/form.html:6
msgid "THE DETAILS THAT MATTER"
msgstr "DIE WICHTIGEN DETAILS"

#: app/web/templates/devices/form.html:8
msgid "Give your device a name you will recognise."
msgstr "Gib deinem Gerät einen Namen, den du wiedererkennst."

#: app/web/templates/devices/form.html:9
msgid "Looking for suggestions…"
msgstr "Vorschläge werden gesucht…"

#: app/web/templates/devices/form.html:9
msgid "Suggestions from your devices. Keep typing to enter a new value."
msgstr "Vorschläge aus deinen Geräten. Du kannst auch einen neuen Wert eingeben."

#: app/web/templates/devices/form.html:9
msgid "No suggestions. You can enter a new value."
msgstr "Keine Vorschläge. Du kannst einen neuen Wert eingeben."

#: app/web/templates/devices/form.html:9
msgid "Suggestions are unavailable. You can still enter a value."
msgstr "Vorschläge sind gerade nicht verfügbar. Du kannst trotzdem einen Wert eingeben."

#: app/web/templates/devices/form.html:9
msgid "Could not save the device. Your entries are still here. Please retry."
msgstr ""
"Das Gerät konnte nicht gespeichert werden. Deine Eingaben bleiben erhalten. Bitte versuche es"
" erneut."

#: app/web/templates/devices/form.html:20
msgid "Save device"
msgstr "Gerät speichern"

#: app/web/templates/devices/form.html:20
msgid "Cancel"
msgstr "Abbrechen"

#: app/web/templates/devices/form.html:22
msgid "View device"
msgstr "Gerät ansehen"

#: app/web/templates/devices/index.html:4
msgid "Loading devices…"
msgstr "Geräte werden geladen…"

#: app/web/templates/devices/index.html:4
msgid "Could not load devices. Please retry."
msgstr "Geräte konnten nicht geladen werden. Bitte versuche es erneut."

#: app/web/templates/devices/index.html:5
msgid "A place for the things worth keeping."
msgstr "Ein Platz für die Dinge, die du behalten möchtest."

#: app/web/templates/devices/index.html:6
#, python-format
msgid "%(count)s devices"
msgstr "%(count)s Geräte"

#: app/web/templates/devices/index.html:7
msgid "Start with your first device."
msgstr "Beginne mit deinem ersten Gerät."

#: app/web/templates/devices/index.html:7
msgid "Add its name, manufacturer and model. Keep the details ready for its next repair."
msgstr "Erfasse Name, Hersteller und Modell. So sind die Details für die nächste Reparatur bereit."

#: app/web/templates/devices/index.html:8
msgid "Device list"
msgstr "Geräteliste"

#: app/web/templates/devices/index.html:12
msgid "Edit"
msgstr "Bearbeiten"

#: app/web/templates/devices/index.html:17
msgid "Retry"
msgstr "Erneut versuchen"

#: app/web/templates/devices/index.html:18
msgid "Device pages"
msgstr "Geräteseiten"

#: app/web/templates/devices/index.html:19
msgid "Previous devices"
msgstr "Vorherige Geräte"

#: app/web/templates/devices/index.html:20
msgid "Next devices"
msgstr "Nächste Geräte"

#: app/web/templates/partials/metadata.html:5
msgid "Log in to your RepairHub account and return to your personal repair workshop."
msgstr "Melde dich bei RepairHub an und kehre zu deiner persönlichen Reparaturwerkstatt zurück."

#: app/web/templates/partials/metadata.html:6
msgid "Create your RepairHub account. A new chapter for your things starts here."
msgstr "Erstelle dein RepairHub-Konto. Hier beginnt ein neues Kapitel für deine Dinge."

#: app/web/templates/partials/metadata.html:7
msgid "Request a new confirmation email to activate your RepairHub account."
msgstr "Fordere eine neue Bestätigungs-E-Mail an, um dein RepairHub-Konto zu aktivieren."

#: app/web/templates/partials/metadata.html:9
msgid "A personal workshop for the things you care about. Start your repair journey with RepairHub."
msgstr ""
"Eine persönliche Werkstatt für die Dinge, die dir wichtig sind. Starte deine Reparaturreise "
"mit RepairHub."

#: app/web/templates/security/_form.html:3
msgid "Please check the highlighted fields."
msgstr "Bitte prüfe die markierten Eingaben."

#: app/web/templates/security/_form.html:19
msgid "8–128 characters. Spaces and special characters welcome."
msgstr "8–128 Zeichen. Leerzeichen und Sonderzeichen sind erlaubt."

#: app/web/templates/security/_form.html:22
msgid "Enter your email address."
msgstr "Gib deine E-Mail-Adresse ein."

#: app/web/templates/security/_form.html:23
msgid "Enter a valid email address, for example name@example.org."
msgstr "Gib eine gültige E-Mail-Adresse ein, zum Beispiel name@example.org."

#: app/web/templates/security/_form.html:26
#, python-format
msgid "Use at least %(minimum)s characters."
msgstr "Verwende mindestens %(minimum)s Zeichen."

#: app/web/templates/security/_form.html:29
msgid "Passwords must match."
msgstr "Die Passwörter müssen übereinstimmen."

#: app/web/templates/security/_layout.html:4
msgid "The RepairHub idea"
msgstr "Die Idee hinter RepairHub"

#: app/web/templates/security/_layout.html:5
msgid "LESS WASTE. MORE POSSIBILITY."
msgstr "WENIGER ABFALL. MEHR MÖGLICHKEITEN."

#: app/web/templates/security/_layout.html:6
msgid "Every fix starts with a little care."
msgstr "Jede Reparatur beginnt mit etwas Sorgfalt."

#: app/web/templates/security/_layout.html:8
msgid "For the well-loved, the worn-in and the worth-keeping."
msgstr "Für lieb gewonnene, oft gebrauchte und erhaltenswerte Dinge."

#: app/web/templates/security/_layout.html:12 app/web/templates/security/email/_base.html:21
msgid "YOUR WORKSHOP STARTS HERE"
msgstr "HIER BEGINNT DEINE WERKSTATT"

#: app/web/templates/security/forgot_password.html:3
#: app/web/templates/security/forgot_password.html:6 app/web/templates/security/login_user.html:9
msgid "Forgot password?"
msgstr "Passwort vergessen?"

#: app/web/templates/security/email/reset_instructions.html:5
#: app/web/templates/security/forgot_password.html:4 app/web/templates/security/login_user.html:4
#: app/web/templates/security/reset_password.html:4
msgid "WELCOME BACK"
msgstr "WILLKOMMEN ZURÜCK"

#: app/web/templates/security/forgot_password.html:7
msgid "Enter your email address. If an account matches, we will send you a password reset link."
msgstr ""
"Gib deine E-Mail-Adresse ein. Falls ein Konto dazu existiert, senden wir dir einen Link zum "
"Zurücksetzen des Passworts."

#: app/web/templates/security/forgot_password.html:9
#: app/web/templates/security/reset_password.html:9
#: app/web/templates/security/send_confirmation.html:10
msgid "Back to log in"
msgstr "Zurück zur Anmeldung"

#: app/web/templates/security/login_user.html:7
msgid "A little care goes a long way. Pick up where you left off."
msgstr "Ein wenig Sorgfalt bewirkt viel. Mach dort weiter, wo du aufgehört hast."

#: app/web/templates/security/login_user.html:10 app/web/templates/security/register_user.html:8
msgid "Resend confirmation link"
msgstr "Bestätigungslink erneut senden"

#: app/web/templates/security/login_user.html:11
msgid "New to RepairHub?"
msgstr "Neu bei RepairHub?"

#: app/web/templates/security/register_user.html:6
msgid "Make room for a repair-first mindset. We will email you a link to confirm your account."
msgstr "Reparieren statt ersetzen. Wir senden dir einen Link per E-Mail, um dein Konto zu bestätigen."

#: app/web/templates/security/register_user.html:9
msgid "Already have an account?"
msgstr "Hast du bereits ein Konto?"

#: app/web/templates/security/email/reset_instructions.html:3
#: app/web/templates/security/email/reset_instructions.html:6
#: app/web/templates/security/email/reset_instructions.html:8
#: app/web/templates/security/email/reset_instructions.txt:1
#: app/web/templates/security/reset_password.html:3
#: app/web/templates/security/reset_password.html:6
msgid "Reset your password"
msgstr "Passwort zurücksetzen"

#: app/web/templates/security/reset_password.html:7
msgid "Choose a new password, then log in again."
msgstr "Wähle ein neues Passwort und melde dich danach erneut an."

#: app/web/templates/security/send_confirmation.html:3
msgid "Confirm email"
msgstr "E-Mail bestätigen"

#: app/web/templates/security/email/confirmation_instructions.html:2
#: app/web/templates/security/send_confirmation.html:4
msgid "ONE SMALL STEP"
msgstr "EIN KLEINER SCHRITT"

#: app/web/templates/security/send_confirmation.html:6
msgid "Check your inbox"
msgstr "Schau in dein Postfach"

#: app/web/templates/security/send_confirmation.html:7
msgid ""
"Enter your email and we will send a fresh confirmation link. Confirm your address before "
"logging in."
msgstr ""
"Gib deine E-Mail-Adresse ein und wir senden dir einen neuen Bestätigungslink. Bestätige deine"
" Adresse vor der Anmeldung."

#: app/web/templates/security/send_confirmation.html:8
msgid "Confirmation links are valid for 24 hours."
msgstr "Bestätigungslinks sind 24 Stunden gültig."

#: app/web/templates/security/email/_base.html:7 app/web/templates/security/email/_base.html:22
#: app/web/templates/security/email/_base.html:27
#: app/web/templates/security/email/confirmation_instructions.txt:1
msgid "Confirm your email address"
msgstr "E-Mail-Adresse bestätigen"

#: app/web/templates/security/email/_base.html:10
msgid "One small step: confirm your email and make yourself at home in RepairHub."
msgstr "Ein kleiner Schritt: Bestätige deine E-Mail-Adresse und richte dich bei RepairHub ein."

#: app/web/templates/security/email/_base.html:18
msgid "KEEP. REPAIR. REPEAT."
msgstr "BEHALTEN. REPARIEREN. WEITERMACHEN."

#: app/web/templates/security/email/_base.html:30
#: app/web/templates/security/email/confirmation_instructions.txt:6
#: app/web/templates/security/email/welcome.txt:6
msgid "This link is valid for 24 hours. Confirm your email before logging in."
msgstr "Dieser Link ist 24 Stunden gültig. Bestätige deine E-Mail-Adresse vor der Anmeldung."

#: app/web/templates/security/email/_base.html:33
msgid "Button not working? Copy this link into your browser:"
msgstr "Funktioniert der Button nicht? Kopiere diesen Link in deinen Browser:"

#: app/web/templates/security/email/_base.html:40
#: app/web/templates/security/email/confirmation_instructions.txt:7
#: app/web/templates/security/email/welcome.txt:7
#: app/web/templates/security/email/welcome_existing.html:6
#: app/web/templates/security/email/welcome_existing.txt:4
#: app/web/templates/security/email/welcome_existing_username.html:6
#: app/web/templates/security/email/welcome_existing_username.txt:4
msgid "If you did not create an account, you can ignore this message."
msgstr "Falls du kein Konto erstellt hast, kannst du diese Nachricht ignorieren."

#: app/web/templates/security/email/confirmation_instructions.html:3
#: app/web/templates/security/email/confirmation_instructions.txt:3
msgid ""
"Here is your new confirmation link. Confirm your email address to get your account ready for "
"your next chapter of fixing things."
msgstr ""
"Hier ist dein neuer Bestätigungslink. Bestätige deine E-Mail-Adresse, damit dein Konto für "
"die nächsten Reparaturen bereit ist."

#: app/web/templates/security/email/reset_instructions.html:4
msgid "A fresh start for your RepairHub account."
msgstr "Ein neuer Start für dein RepairHub-Konto."

#: app/web/templates/security/email/reset_instructions.html:7
#: app/web/templates/security/email/reset_instructions.txt:3
msgid "Use the link below to choose a new password for your RepairHub account."
msgstr "Wähle über den folgenden Link ein neues Passwort für dein RepairHub-Konto."

#: app/web/templates/security/email/reset_instructions.html:9
#: app/web/templates/security/email/reset_instructions.txt:6
msgid "This link is valid for one hour and can only be used once."
msgstr "Dieser Link ist eine Stunde gültig und kann nur einmal verwendet werden."

#: app/web/templates/security/email/reset_instructions.html:10
#: app/web/templates/security/email/reset_instructions.txt:7
msgid "If you did not request a password reset, ignore this email. Your password will stay unchanged."
msgstr ""
"Falls du kein neues Passwort angefordert hast, ignoriere diese E-Mail. Dein Passwort bleibt "
"unverändert."

#: app/web/templates/security/email/reset_notice.html:2
#: app/web/templates/security/email/reset_notice.html:3
#: app/web/templates/security/email/reset_notice.html:5
#: app/web/templates/security/email/reset_notice.txt:1
msgid "Your password has been reset"
msgstr "Dein Passwort wurde zurückgesetzt"

#: app/web/templates/security/email/reset_notice.html:6
#: app/web/templates/security/email/reset_notice.txt:3
msgid "Your RepairHub password was changed. You can now log in with your new password."
msgstr ""
"Dein RepairHub-Passwort wurde geändert. Du kannst dich jetzt mit deinem neuen Passwort "
"anmelden."

#: app/web/templates/security/email/reset_notice.html:8
#: app/web/templates/security/email/reset_notice.txt:4
msgid "If you did not make this change, reset your password immediately using the login page."
msgstr ""
"Falls du diese Änderung nicht vorgenommen hast, setze dein Passwort sofort über die "
"Anmeldeseite zurück."

#: app/web/templates/security/email/welcome.html:2 app/web/templates/security/email/welcome.txt:1
msgid "Welcome to RepairHub."
msgstr "Willkommen bei RepairHub."

#: app/web/templates/security/email/welcome.html:3
msgid ""
"Good to have you here. Confirm your email address to finish setting up your account and step "
"into your personal repair workshop."
msgstr ""
"Schön, dass du da bist. Bestätige deine E-Mail-Adresse, um dein Konto einzurichten und deine "
"persönliche Reparaturwerkstatt zu betreten."

#: app/web/templates/security/email/welcome.txt:3
msgid "Please confirm your email address using this link:"
msgstr "Bitte bestätige deine E-Mail-Adresse über diesen Link:"

#: app/web/templates/security/email/welcome_existing.html:2
#: app/web/templates/security/email/welcome_existing.html:3
