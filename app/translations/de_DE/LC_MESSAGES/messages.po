#: app/web/templates/security/email/confirmation_instructions.txt:3
msgid ""
"Here is your new confirmation link. Confirm your email address to get "
"your account ready for your next chapter of fixing things."
msgstr ""
"Hier ist dein neuer Bestätigungslink. Bestätige deine E-Mail-Adresse, "
"damit dein Konto für die nächsten Reparaturen bereit ist."

