@startuml
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam backgroundColor white
skinparam ArrowColor #243b35
skinparam componentBackgroundColor #f2f5f3
skinparam classBackgroundColor #f2f5f3
skinparam wrapWidth 180
title RepairHub – authentifizierter API-Lesezugriff
actor Client
participant "REST-API" as API
participant "users.authenticate_api_key" as Auth
participant "Key-Adapter" as Key
participant "repairs.get_repair" as Repair
participant "Read-Port / ORM-Adapter" as Data
participant "costs.calculate" as Costs
Client -> API : GET /api/repairs/{id}\nAuthorization: Bearer <api-key>
API -> Auth : Schlüssel authentifizieren
Auth -> Key : Hash / Identitätsbindung prüfen
Key --> Auth : persönliche oder System-Identität
Auth --> API : Identität oder ungültig
alt ungültiger Schlüssel
 API --> Client : 401 JSON
else gültiger Schlüssel
 API -> Repair : Fall-ID + vertrauenswürdige Leseberechtigung
 Repair -> Data : Fall, Schritte, Teile lesen
 note right of Data
 Persönlich: Eigentumsfilter.
 System: explizit alle Reparaturen.
 end note
 Data --> Repair : DTOs oder kein Treffer
 alt fremd / unbekannt
  Repair --> API : nicht gefunden
  API --> Client : 404 JSON
 else zugänglich
  Repair -> Costs : Dezimalwerte berechnen
  Costs --> Repair : CHF-Kosten
  Repair --> API : vollständige Fallauskunft
  API --> Client : 200 JSON; Dezimalstrings
 end
end
@enduml
