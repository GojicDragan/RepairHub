# Als .env kopieren: nicht geheime Compose-Konfiguration.
# App-/Datenbank-Platzhalter ersetzen; runtime.env separat anlegen (chmod 600).
# Nginx und PostgreSQL verwenden die freigegebenen offiziellen Infrastruktur-Pins.
REPAIRHUB_APP_IMAGE=CHANGE_ME
REPAIRHUB_NGINX_IMAGE=nginx:1.30.5-alpine@sha256:a5f2157a0302eb0c5e300415effb63a9e70ed1eb9c107283819bf6d149ab607c
REPAIRHUB_POSTGRES_IMAGE=postgres:17.11-alpine3.24@sha256:f02121de6f74d30d8a94cd1d9584125e2178d7e6c377d8130112d4e52d867995
POSTGRES_DB=CHANGE_ME
POSTGRES_USER=CHANGE_ME
APP_ENV_FILE=./runtime.env
DATABASE_ENV_FILE=./runtime.env
NGINX_CONFIG_DIRECTORY=./deploy/nginx
TLS_DIRECTORY=./tls
STATIC_ROOT=./www
HTTPS_HOST_PORT=443
HTTP_LOCAL_PORT=8080
MAILPIT_LOCAL_PORT=8025

# Separat in runtime.env, nicht in .env und nicht im Repository:
# SECRET_KEY=CHANGE_ME
# POSTGRES_PASSWORD=CHANGE_ME
# DATABASE_URL=postgresql+psycopg://CHANGE_ME:CHANGE_ME@db:5432/CHANGE_ME
# DATABASE_URL benötigt URL-kodierte Sonderzeichen im Benutzernamen/Passwort.
# SECRET_KEY benötigt mindestens 32 zufällige Zeichen.

# Nur Produktion: externer SMTP-Zugang in der geschützten runtime.env.
# Development verwendet automatisch Mailpit und überschreibt diese SMTP-Werte.
# PUBLIC_URL=https://CHANGE_ME
# MAIL_SERVER=CHANGE_ME
# MAIL_PORT=587
# MAIL_DEFAULT_SENDER=CHANGE_ME
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false
# MAIL_USERNAME=CHANGE_ME
# MAIL_PASSWORD=CHANGE_ME
# STARTTLS auf 587 oder TLS auf 465 (USE_TLS=false, USE_SSL=true).

# Optional in runtime.env: System-Leseschlüssel; leer = deaktiviert.
# API_SMOKE_KEY=rh_<43 zufällige URL-sichere Zeichen>
